      <aliases enabled='yes' />
      <column caption='BEV_VEHICLE %' datatype='real' name='[BEV_VEHICLE (copy)_1650122159558666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Electric Vehicle Type] = &quot;Battery Electric Vehicle (BEV)&quot; THEN [VIN (1-10)] END )/COUNT([VIN (1-10)])*100' />
      </column>
      <column caption='REPLACE_VEHICLE_TYPE' datatype='string' name='[Calculation_1650122141757440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(REPLACE([Electric Vehicle Type],&quot;Battery Electric Vehicle (BEV)&quot;,&quot;Battery Electric Vehicle&quot;), &quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;, &quot;Hybrid Electric Vehicle&quot;)' />
      </column>
      <column caption='ZERO_AXIS' datatype='integer' name='[Calculation_1650122145566721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='ELECT_RANGE_BIN' datatype='string' name='[Calculation_1650122146013186]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Electric Range]&lt;=100 THEN &quot;LOW&quot; &#13;&#10;ELSEIF [Electric Range]&gt;200 THEN &quot;HIGH&quot;&#13;&#10;ELSE &quot;MEDIUM&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Latitude_location' datatype='string' name='[Calculation_1650122149756931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(SPLIT([Vehicle Location],&quot; &quot;,2), &quot;(&quot;,&quot;&quot;)' />
      </column>
      <column caption='FULL_ADDRESS' datatype='string' name='[Calculation_1650122152226821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[City]+&quot;,&quot;+ REPLACE([State],&quot;WA&quot;, &quot;Washington&quot;)+&quot;,&quot;+STR([Postal Code])' />
      </column>
      <column caption='TOTAL_VEHICLE' datatype='integer' name='[Calculation_1650122154762246]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([VIN (1-10)])' />
      </column>
      <column caption='AVG_ELECT_RANGE' datatype='real' datatype-customized='true' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1650122155728903]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='AVG([Electric Range])' />
      </column>
      <column caption='BEV_VEHICLE' datatype='integer' name='[Calculation_1650122158837769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Electric Vehicle Type] = &quot;Battery Electric Vehicle (BEV)&quot; THEN [VIN (1-10)] END )' />
      </column>
      <column caption='PHEV_VEHICLE' datatype='integer' name='[Calculation_1650122160332811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([VIN (1-10)])-[Calculation_1650122158837769]' />
      </column>
      <column caption='PHEV_VEHICLE%' datatype='real' name='[Calculation_1650122160545804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100-[BEV_VEHICLE (copy)_1650122159558666]' />
      </column>
      <column caption='CAFV ELIGIBLE' datatype='integer' name='[Calculation_1650122169098253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Clean Alternative Fuel Vehicle (CAFV) Eligibility]=&quot;Clean Alternative Fuel Vehicle Eligible&quot; THEN [VIN (1-10)] END)' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Clean Alternative Fuel Vehicle (CAFV) Eligibility]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Clean Alternative Fuel Vehicle Eligible&quot;' value='Eligible' />
          <alias key='&quot;Eligibility unknown as battery range has not been researched&quot;' value='Unknown' />
          <alias key='&quot;Not eligible due to low battery range&quot;' value='Not Eligible' />
        </aliases>
      </column>
      <column datatype='string' name='[County]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
      <column aggregation='None' caption='Electric Range (bin)' datatype='integer' name='[Electric Range (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[Electric Range]' peg='0' size='20' />
      </column>
      <column datatype='integer' name='[Electric Range]' role='measure' type='quantitative' />
      <column datatype='string' name='[Electric Vehicle Type]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Battery Electric Vehicle (BEV)&quot;' value='BEV' />
          <alias key='&quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;' value='PHEV' />
        </aliases>
      </column>
      <column caption='Longitude_location' datatype='string' name='[Latitude_location (copy)_1650122150150148]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(SPLIT([Vehicle Location],&quot; &quot;,3), &quot;)&quot;,&quot;&quot;)' />
      </column>
      <column datatype='string' name='[Make]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Model Year]' role='dimension' type='quantitative' />
      <column datatype='string' name='[Model]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
