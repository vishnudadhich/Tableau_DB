      <column caption='timely_response' datatype='real' name='[Calculation_1072328473784321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF[Timely response?]=&quot;Yes&quot; THEN [Complaint ID]END)/SUM([Calculation_1072328471924736])' />
      </column>
      <column caption='non timely response' datatype='real' name='[Calculation_1072328475414530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF[Timely response?]=&quot;No&quot; THEN [Complaint ID]END)/SUM([Calculation_1072328471924736])' />
      </column>
      <column caption='no cost resolution ?' datatype='real' name='[Calculation_1072328513331205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNT(IF[Company response to consumer]!=&quot;Closed with non-monetary relief&quot; THEN [Company response to consumer]END)- COUNT(IF[Company response to consumer]=&quot;In progress&quot; THEN [Company response to consumer]END))/SUM([Calculation_1072328471924736])' />
      </column>
      <column caption='in progress' datatype='integer' name='[Calculation_1072328517218310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Company response to consumer] = &quot;In progress&quot; THEN [Complaint ID] END)' />
      </column>
      <column caption='in progress%' datatype='real' name='[Calculation_1072328517607431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1072328517218310]/COUNT([Complaint ID])' />
      </column>
      <column caption='resolved' datatype='real' name='[Calculation_1072328518238216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1- [Calculation_1072328517607431]' />
      </column>
      <column caption='CLOSED WITH MONETARY RELIEF%' datatype='real' name='[Calculation_1072328520339465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Company response to consumer]= &quot;Closed with monetary relief&quot; THEN[Complaint ID] END)/ COUNT([Complaint ID])' />
      </column>
      <column caption='NO COST RESOLVED%' datatype='real' name='[Calculation_1072328520908810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[Calculation_1072328520339465]' />
